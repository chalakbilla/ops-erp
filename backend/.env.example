# Copy to .env and adjust as needed.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Defaults to a local SQLite file if not set. Point this at Postgres/MySQL in
# production, e.g. postgresql://user:pass@host:5432/opserp
DATABASE_URL=sqlite:///instance/erp.db

CORS_ORIGINS=*
PORT=5000
FLASK_DEBUG=1
